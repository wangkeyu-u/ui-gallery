# Set only on the backend. Never put real secrets in GitHub or frontend code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Two model calls per analysis by default: synthesis then review. Set false for single-pass.
DEEPSEEK_REVIEW=true
# Generate a separate 24+ character access code; this is NOT the DeepSeek API key.
ANALYSIS_ACCESS_TOKEN=
# Cross-origin Pages frontend uses the origin, not the repository path.
ALLOWED_ORIGINS=https://wangkeyu-u.github.io
AI_REQUESTS_PER_HOUR=6
PORT=4173
